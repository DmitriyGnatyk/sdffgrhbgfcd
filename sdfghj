            end
        end
        task.wait(KEY_RECHECK_INTERVAL)
    end
end)

-- ═══════════ ENTRY POINT ═══════════
local savedKey = loadSavedKey()

if savedKey and savedKey ~= "" then
    local valid, profile, expiresAt = verifyKey(savedKey)
    if valid then
        getgenv().TelegramProfile = profile
        getgenv().PreferredLanguage = loadSavedLanguage()
        getgenv().Config = getgenv().Config or {}
        loadAllSettings()
        applyTheme(getgenv().Config.Theme or "Ice")
        local showMenu = StartMainMenu()
        showWelcomeSplash(profile, showMenu, loadSavedLanguage(), true)
    else
        local T = KeyUI[currentLang] or KeyUI.ENG
        local msg = profile or T.hint_invalid
        if type(msg) == "string" then
            if msg:find("Connection") or msg:find("No HTTP") then msg = T.hint_error end
            if msg:find("Invalid") then msg = T.hint_invalid end
        end
        createKeyGUI(currentLang, savedKey, msg, "error")
    end
else
    createKeyGUI(currentLang, "", nil, nil)
end
