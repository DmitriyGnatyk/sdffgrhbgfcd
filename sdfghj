    local aimTarget, aimChar = nil, nil
    local function pickAimPart(char)
        if not char then return nil end
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        if getgenv().Config.Wallbang then return head or torso end
        return math.random(1,100) <= getgenv().Config.HeadshotChance and head or torso
    end

    local function hasLOS(targetPart, targetChar)
        if getgenv().Config.Wallbang then return true end
        local origin = CurrentCamera.CFrame.Position
        local dir = targetPart.Position - origin
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { CurrentCamera, f6(LocalPlayer) }
        local r = Workspace:Raycast(origin, dir, rp)
        if r and r.Instance then return r.Instance:IsDescendantOf(targetChar) end
        return true
    end

    local function findTarget()
        if not getgenv().Config.SilentAim then aimTarget = nil; aimChar = nil; return end
        local center = Vector2.new(CurrentCamera.ViewportSize.X/2, CurrentCamera.ViewportSize.Y/2)
        local myTeam = f7(f6(LocalPlayer), LocalPlayer)
        local bestDist, bestChar, bestPart = math.huge, nil, nil
        local radius = getgenv().Config.Wallbang and 600 or getgenv().Config.FOVRadius
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = f6(plr)
                if char then
                    local dead = char:GetAttribute("Dead") or false
                    local hp = char:GetAttribute("Health") or 100
                    if not dead and hp > 0 then
                        local enemy = true
                        if getgenv().Config.SilentTeamCheck and myTeam then
                            local t = f7(char, plr)
                            enemy = (t == nil or myTeam == nil or t ~= myTeam)
                        end
                        if enemy then
                            local head = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso")
                                or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
                            if head and (getgenv().Config.Wallbang or hasLOS(head, char)) then
                                local sp, onScreen = CurrentCamera:WorldToViewportPoint(head.Position)
                                if onScreen and sp.Z > 0 then
                                    local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                    if m <= radius and m < bestDist then
                                        bestDist = m; bestChar = char; bestPart = head
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        aimTarget = bestPart; aimChar = bestChar
    end

