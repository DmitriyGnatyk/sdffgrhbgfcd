        local displayedVal = getgenv().Config[configKey]
        local animToken = 0
        local function updateText()
            local newVal = getgenv().Config[configKey]
            lbl.Text = (L[getgenv().Config.Language][textKey] or textKey) .. ": "
            animToken = animToken + 1
            local myToken = animToken
            if newVal == displayedVal then
                valLbl.Text = tostring(newVal)
                return
            end
            local startVal = displayedVal
            displayedVal = newVal
            local diff = newVal - startVal
            local steps = math.max(4, math.min(14, math.abs(diff)))
            task.spawn(function()
                for i = 1, steps do
                    if myToken ~= animToken then return end
                    valLbl.Text = tostring(math.floor(startVal + diff * (i / steps) + 0.5))
                    task.wait(0.018)
                end
                if myToken == animToken then
                    valLbl.Text = tostring(newVal)
                end
            end)
        end
        updateText()
        table.insert(textElements, {obj = lbl, key = textKey, type = "text", refresh = updateText})
        local function setVal(relX, width)
            if width <= 0 then return end
            local p = math.clamp(relX / width, 0, 1)
            local val = math.floor((minV + p * (maxV - minV)) / step + 0.5) * step
            val = math.clamp(val, minV, maxV)
            getgenv().Config[configKey] = val
            fill.Size = UDim2.new(p, 0, 1, 0)
            handle.Position = UDim2.new(p, -10, 0.5, -10)
            updateText()
        end
        local function beginDrag()
            local sf = parent
            if sf and sf:IsA("ScrollingFrame") then sf.ScrollingEnabled = false end
            sliderDragState = {track = track, setValue = setVal, scrollFrame = sf}
        end
        track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                beginDrag(); setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
            end
        end)
        handle.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                beginDrag(); setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
            end
        end)
        return frame
    end

