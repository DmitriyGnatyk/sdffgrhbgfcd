local function safeReadFile(path)
    local ok, data = pcall(function()
        if typeof(isfile) == "function" and isfile(path) then return readfile(path) end
    end)
    if ok and data and data ~= "" then return data end
    return nil
end
local function safeWriteFile(path, data)
    pcall(function()
        if typeof(writefile) == "function" then writefile(path, data) end
    end)
end
local function safeDeleteFile(path)
    pcall(function()
        if typeof(delfile) == "function" and typeof(isfile) == "function" and isfile(path) then
            delfile(path)
        end
    end)
end

