    local function f3(gloveName, gloveSkin)
        if not skins then return end
        local gloveFolder = skins:FindFirstChild(gloveName)
        if not gloveFolder then return end
        local skinVariant = gloveFolder:FindFirstChild(gloveSkin) or gloveFolder:GetChildren()[1]
        if not skinVariant then return end
        local camera = skinVariant:FindFirstChild("Camera") or skinVariant:FindFirstChild("Character")
        local wearFolder = camera and (camera:FindFirstChild(getgenv().Config.SelectedWear)
            or camera:FindFirstChild("Factory New") or camera:GetChildren()[1])
        if not wearFolder then return end

        local leftArm  = wearFolder:FindFirstChild("Left Arm")
        local rightArm = wearFolder:FindFirstChild("Right Arm")

        for _, model in ipairs(CurrentCamera:GetChildren()) do
            if model:IsA("Model") then
                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("MeshPart") then
                        if part.Name == "Left Arm" or part.Name == "Right Arm" then
                            for _, child in ipairs(part:GetChildren()) do
                                if child:IsA("SurfaceAppearance") then
                                    child:Destroy()
                                end
                            end
                        elseif part.Name == "Glove" then
                            local parent = part.Parent and part.Parent.Name == "Left Arm" and leftArm or rightArm
                            if parent then
                                local existingSA = part:FindFirstChildOfClass("SurfaceAppearance")
                                local tagKey = gloveName .. "_" .. gloveSkin
                                if not existingSA or existingSA:GetAttribute("CustomApplied") ~= tagKey then
                                    if existingSA then existingSA:Destroy() end
                                    local clone = parent:Clone()
                                    clone:SetAttribute("CustomApplied", tagKey)
                                    clone.Parent = part
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local function applySkinToModel(model, modelName, skinName, forceKnifeName)
        if not skins or not model or not modelName or not skinName then return end
        local lookupName = modelName
        if forceKnifeName and isKnife(modelName) then
            lookupName = forceKnifeName
        end
        local skinFolder = skins:FindFirstChild(lookupName)
        if not skinFolder then return end
        local skinVariant = skinFolder:FindFirstChild(skinName) or skinFolder:GetChildren()[1]
        if not skinVariant then return end
        local camera = skinVariant:FindFirstChild("Character") or skinVariant:FindFirstChild("Camera")
        local wearFolder = camera and (camera:FindFirstChild(getgenv().Config.SelectedWear)
            or camera:FindFirstChild("Factory New") or camera:GetChildren()[1])
        if not wearFolder then return end
        local tagKey = lookupName .. "_" .. skinName
        for _, sourceItem in ipairs(wearFolder:GetChildren()) do
            if sourceItem:IsA("SurfaceAppearance") then
                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("MeshPart") and part.Name == sourceItem.Name then
                        local existingSA = part:FindFirstChildOfClass("SurfaceAppearance")
                        if not existingSA or existingSA:GetAttribute("CustomApplied") ~= tagKey then
                            if existingSA then existingSA:Destroy() end
                            local clone = sourceItem:Clone()
                            clone:SetAttribute("CustomApplied", tagKey)
                            clone.Parent = part
                        end
                    end
                end
            elseif sourceItem:IsA("MeshPart") or sourceItem:IsA("BasePart") then
                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("MeshPart") and part.Name == sourceItem.Name then
                        local sourceSA = sourceItem:FindFirstChildOfClass("SurfaceAppearance")
                        if sourceSA then
                            local existingSA = part:FindFirstChildOfClass("SurfaceAppearance")
                            local tagKey2 = tagKey .. "_" .. part.Name
                            if not existingSA or existingSA:GetAttribute("CustomApplied") ~= tagKey2 then
                                if existingSA then existingSA:Destroy() end
                                local saClone = sourceSA:Clone()
                                saClone:SetAttribute("CustomApplied", tagKey2)
                                saClone.Parent = part
                            end
                        end
                    end
                end
            end
        end
    end

