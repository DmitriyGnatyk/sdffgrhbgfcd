getgenv().SXNT_KeyRecheckLoop = task.spawn(function()
    task.wait(30)
    local expiredNotified = false
    while true do
        local k = loadSavedKey()
        if k and k ~= "" then
            local valid, reason = verifyKey(k)
            if not valid then
                clearSavedKey()
                if not expiredNotified then
                    expiredNotified = true
                    pcall(function()
                        local notify = Instance.new("ScreenGui")
                        notify.Name = "SxntKeyExpired"
                        notify.ResetOnSpawn = false
                        notify.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                        notify.Parent = GetMainGui()

                        local card = Instance.new("Frame", notify)
                        local cardW, cardH = 380, 150
                        card.Size = UDim2.new(0, cardW, 0, cardH)
                        card.Position = UDim2.new(0.5, -cardW/2, 0, 30)
                        card.BackgroundColor3 = Theme.bg; card.BorderSizePixel = 0
                        uiCorner(card, 14); uiStroke(card, Theme.red, 1.5, 0.3)
                        if IS_MOBILE then
                            local vp = CurrentCamera.ViewportSize
                            local s = math.min(1, (vp.X * 0.95) / cardW)
                            if s < 1 then Instance.new("UIScale", card).Scale = s end
                        end

                        local bar = Instance.new("Frame", card)
                        bar.Size = UDim2.new(1, 0, 0, 3); bar.BorderSizePixel = 0
                        bar.BackgroundColor3 = Theme.red; uiCorner(bar, 14)

                        local curLang = (getgenv().Config and getgenv().Config.Language) or loadSavedLanguage()
                        local T = KeyUI[curLang] or KeyUI.ENG
                        local t = Instance.new("TextLabel", card)
                        t.Text = reasonToMessage(reason, T)
                        t.Font = Enum.Font.Cartoon; t.TextSize = 14
                        t.TextColor3 = Theme.red; t.Size = UDim2.new(1, -30, 0, 26)
                        t.Position = UDim2.new(0, 15, 0, 20); t.BackgroundTransparency = 1
                        t.TextXAlignment = Enum.TextXAlignment.Left

                        local t2 = Instance.new("TextLabel", card)
                        t2.Text = T.expired_click or "Click below to enter a new key"
                        t2.Font = Enum.Font.Cartoon; t2.TextSize = 12
                        t2.TextColor3 = Theme.muted; t2.Size = UDim2.new(1, -30, 0, 20)
                        t2.Position = UDim2.new(0, 15, 0, 48); t2.BackgroundTransparency = 1
                        t2.TextXAlignment = Enum.TextXAlignment.Left

                        local reactBtn = Instance.new("TextButton", card)
                        reactBtn.Text = T.expired_btn or "ENTER NEW KEY"
                        reactBtn.Font = Enum.Font.Cartoon; reactBtn.TextSize = 13
                        reactBtn.TextColor3 = Color3.new(1,1,1)
                        reactBtn.Size = UDim2.new(1, -30, 0, 38)
