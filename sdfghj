local function animateCardOut(card, cardStroke, cardGrad, onDone)
    uiTween(card, 0.35, { Size = UDim2.new(0, card.Size.X.Offset+40, 0, card.Size.Y.Offset+40), BackgroundTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In):Play()
    if cardStroke then uiTween(cardStroke, 0.35, {Transparency = 1}):Play() end
    if cardGrad then cardGrad:Destroy() end
