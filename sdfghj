        if not skins then return end
        for _, folder in ipairs(skins:GetChildren()) do
            local n = folder.Name
            local subs = {}
            for _, s in ipairs(folder:GetChildren()) do
                table.insert(subs, s.Name)
            end
            table.sort(subs)
            if isKnife(n) then
                SkinCategories.Knives[n] = subs
            elseif string.find(n, "Glove") or string.find(n, "Wraps") then
                SkinCategories.Gloves[n] = subs
            else
                SkinCategories.Weapons[n] = subs
            end
        end
