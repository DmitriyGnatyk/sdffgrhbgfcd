                        reactBtn.BackgroundColor3 = Theme.accent; reactBtn.BorderSizePixel = 0
                        reactBtn.AutoButtonColor = false; uiCorner(reactBtn, 8)
                        addGradient(reactBtn, Theme.accent, Theme.accent2, 0)
                        reactBtn.MouseButton1Click:Connect(function()
                            notify:Destroy()
                            expiredNotified = false
                            createKeyGUI(curLang, "", nil, nil)
