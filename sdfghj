local function httpGet(url)
    if syn and syn.request then
        local ok, res = pcall(syn.request, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.StatusCode, res.Body end
    end
    if typeof(request) == "function" then
        local ok, res = pcall(request, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.StatusCode, res.Body end
    end
    if typeof(http_request) == "function" then
        local ok, res = pcall(http_request, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.StatusCode, res.Body end
    end
    if http and typeof(http.request) == "function" then
        local ok, res = pcall(http.request, { Url = url, Method = "GET" })
        if ok and res and res.Body then return res.StatusCode, res.Body end
    end
    local ok, res = pcall(function()
        return game:GetService("HttpService"):RequestAsync({
            Url = url, Method = "GET",
            Headers = { ["Accept"] = "application/json" }
        })
    end)
    if ok and res and res.Body then return res.StatusCode, res.Body end
    local ok2, body = pcall(function()
        return game:GetService("HttpService"):GetAsync(url)
    end)
    if ok2 and body then return 200, body end
    return nil, nil
end

local function verifyKey(key)
    if not key or key == "" then return false, "Empty key", nil end
    key = key:gsub("%s+", "")
    local hwid = getHWID()
    local url = VALIDATE_URL .. "?key=" .. key .. "&hwid=" .. hwid
    local status, body = httpGet(url)
    if not body then return false, "No HTTP method worked on your executor", nil end
    if body == "" then return false, "Empty response (status " .. tostring(status) .. ")", nil end
    local result
    local ok = pcall(function() result = game:GetService("HttpService"):JSONDecode(body) end)
    if not ok or type(result) ~= "table" then
        return false, "Bad response (HTTP " .. tostring(status) .. ")", nil
    end
    if result.valid == true then
        local expiresAt = result.expires_at_ms
        return true,
            { first_name = "User", username = "sxnt_user", avatar_url = "", expiresAt = expiresAt },
            expiresAt
    end
    return false, result.reason or "invalid_key", nil
end

local function getHWID()
    local hwid
    pcall(function() if typeof(gethwid) == "function" then hwid = gethwid() end end)
    if not hwid or hwid == "" then
        pcall(function() hwid = game:GetService("RbxAnalyticsService"):GetClientId() end)
    end
    if not hwid or hwid == "" then
        local saved = safeReadFile("sxnt_hwid.txt")
        if saved and saved ~= "" then
            hwid = saved
        else
            hwid = tostring(os.time()) .. "_" .. tostring(math.random(1, 1e9))
            safeWriteFile("sxnt_hwid.txt", hwid)
        end
    end
    return hwid
end

local function reasonToMessage(reason, T)
    if type(reason) ~= "string" then return T.hint_invalid end
    if reason:find("invalid_key")        then return T.hint_invalid     end
    if reason:find("^banned")            then return T.hint_banned      end
    if reason == "expired"               then return T.hint_expired     end
    if reason == "inactive"              then return T.hint_inactive    end
    if reason == "hwid_mismatch"         then return T.hint_hwid        end
    if reason == "rate_limited"          then return T.hint_ratelimit   end
    if reason == "key_and_hwid_required" then return T.hint_no_key      end
    if reason:find("Connection") or reason:find("No HTTP") then return T.hint_error end
    if reason:find("Empty")              then return T.hint_no_key      end
    return T.hint_invalid
end

local function formatTimeLeft(expiresAt)
    if not expiresAt then return "unknown" end
    local nowMs = os.time() * 1000
    local diffMs = expiresAt - nowMs
    if diffMs <= 0 then return "expired" end
    local totalMin = math.floor(diffMs / 60000)
    local h = math.floor(totalMin / 60)
    local m = totalMin % 60
    if h > 0 then return string.format("%dh %dm", h, m) end
    return string.format("%dm", m)
end

