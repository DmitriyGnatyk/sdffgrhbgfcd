local function spawnFloatingDots(container, count, accent)
    local dots = {}
    for i = 1, count or 18 do
        local dot = Instance.new("Frame", container)
        dot.Size = UDim2.new(0, math.random(2,5), 0, math.random(2,5))
        dot.Position = UDim2.new(math.random(),0,math.random(),0)
        dot.BackgroundColor3 = (i % 3 == 0) and Theme.accent2 or accent or Theme.accent
        dot.BackgroundTransparency = math.random(50,85)/100; dot.BorderSizePixel = 0; dot.ZIndex = 0
        uiCorner(dot, 999)
        table.insert(dots, { obj = dot, spd = math.random(8,22)/1000, dir = math.random() > 0.5 and 1 or -1,
            baseX = dot.Position.X.Scale, baseY = dot.Position.Y.Scale })
    end
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not container.Parent then conn:Disconnect() return end
        for _, d in ipairs(dots) do
            local o = d.obj
            if o and o.Parent then
                local ny = (o.Position.Y.Scale + d.spd * d.dir) % 1
                local nx = d.baseX + math.sin(tick()*2 + d.baseY*10) * 0.02
                o.Position = UDim2.new(nx, 0, ny, 0)
            end
        end
    end)
    table.insert(getgenv().SXNT_Connections, conn)
    return conn
end
local function pulseStroke(stroke, c1, c2)
    task.spawn(function()
        while stroke.Parent do
            uiTween(stroke, 1.2, {Color = c2}, Enum.EasingStyle.Sine):Play(); task.wait(1.2)
            if not stroke.Parent then break end
            uiTween(stroke, 1.2, {Color = c1}, Enum.EasingStyle.Sine):Play(); task.wait(1.2)
        end
    end)
end

